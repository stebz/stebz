<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.stebz</groupId>
  <artifactId>stebz-bom</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Stebz BOM</name>
  <description>Stebz BOM</description>

  <url>https://github.com/stebz/stebz</url>

  <developers>
    <developer>
      <id>evpl</id>
      <name>Evgenii Plugatar</name>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://raw.githubusercontent.com/stebz/stebz/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/stebz/stebz/issues</url>
  </issueManagement>

  <scm>
    <connection>scm:git:git@github.com:stebz/stebz.git</connection>
    <developerConnection>scm:git:git@github.com:stebz/stebz.git</developerConnection>
    <url>https://github.com/stebz/stebz</url>
  </scm>

  <properties>
    <revision>1.0-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- the parent POM is a published artifact and is listed here for convenience
           so that consumers can pin its version alongside the other modules -->
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-parent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-utils</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-methods</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-aaa-keywords</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-aaa-methods</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-aaa-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-gherkin-keywords</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-gherkin-methods</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-gherkin-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-clean-stack-trace</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-empty-steps</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-hidden-steps</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-readable-reflective-name</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-repeat-and-retry</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-soft-asserted-steps</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-aaa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-gherkin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-allure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-qase</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-reportportal</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-testit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.stebz</groupId>
        <artifactId>stebz-system-out</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- the BOM pom artifact is published to Maven Central (publishing is aggregated
           in the root pom) and therefore must be flattened and signed -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.8</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals>
              <goal>sign</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
